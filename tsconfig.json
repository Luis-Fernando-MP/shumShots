{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@common/*": ["./src/common/*"],
      "@features/*": ["./src/features/*"],
      "@views/*": ["./src/views/*"],
      "@pages/*": ["./src/app/*"],
      "@editor/*": ["./src/views/image-studio/*"],
      "@editor-store/*": ["./src/views/image-studio/store/*"],
      "@code/*": ["./src/views/code-studio/*"],
      "@code-store/*": ["./src/views/code-studio/store/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
