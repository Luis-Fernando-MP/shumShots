{
  "name": "pixis",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "predev": "node scripts/copy-monaco.mjs",
    "prebuild": "node scripts/copy-monaco.mjs",
    "dev": "next dev --turbopack",
    "build": "pnpm lint && next build",
    "start": "next start",
    "lint": "pnpm exec stylelint '**/*.css' && pnpm exec next lint",
    "format": "pnpm exec stylelint '**/*.css' --fix && pnpm exec prettier --write '**/*.{js,jsx,ts,tsx,json,md,css}'",
